{
  "name": "hydra-strk",
  "version": "0.1.0",
  "description": "Private messaging on Starknet: what leaks is computed from the code that makes it true, never asserted",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesms1246/hydra.git"
  },
  "homepage": "https://hydra-strk.vercel.app",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "hydra": "dist/cli/src/cli.js",
    "hydra-tui": "dist/tui/src/main.js"
  },
  "dependencies": {
    "@scure/starknet": "^2.4.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run check:citations && node --test packages/identity/test/*.test.ts $(ls packages/adversary/test/*.test.ts | grep -v '/live-')",
    "check:citations": "node ../scripts/check-cited-paths.mjs --source",
    "test:live": "node --test packages/adversary/test/live-*.test.ts",
    "redeploy": "node scripts/redeploy.ts",
    "tui": "node packages/tui/src/main.ts",
    "typecheck": "node --experimental-strip-types scripts/typecheck.ts",
    "prepack": "rm -rf dist && npm run build && cp ../LICENSE .",
    "postpack": "rm -rf dist LICENSE",
    "build": "tsc -p tsconfig.build.json"
  }
}
