{
  "name": "@hydra-platform/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hydra platform. Run `npm test` here; the Cairo is `cd contracts && snforge test`.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test packages/identity/test/*.test.ts $(ls packages/adversary/test/*.test.ts | grep -v '/live-')",
    "test:live": "node --test packages/adversary/test/live-*.test.ts",
    "redeploy": "node scripts/redeploy.ts",
    "tui": "node packages/tui/src/main.ts"
  }
}
