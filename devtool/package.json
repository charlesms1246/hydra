{
  "name": "hydra-devtool",
  "version": "0.1.0",
  "description": "A local STRK20 privacy stack, and tooling that computes what a transaction actually discloses",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesms1246/hydra.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "hydra-dev": "packages/cli/src/cli.mjs"
  },
  "exports": {
    ".": "./packages/leak/src/leak.mjs",
    "./facts": "./packages/leak/src/facts.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "packages/cli",
    "packages/core",
    "packages/leak",
    "packages/linter",
    "packages/tui",
    "scripts/test-preflight.mjs",
    "scripts/test-run.mjs",
    "skills-lock.json",
    "!packages/*/node_modules"
  ],
  "scripts": {
    "test": "node scripts/test-preflight.mjs && node scripts/test-run.mjs",
    "prepack": "cp ../LICENSE .",
    "postpack": "rm -f LICENSE"
  }
}
