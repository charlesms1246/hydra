# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Mainnet (CHAIN_ID SN_MAIN). Free key from https://www.alchemy.com
STARKNET_MAINNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Keyless public endpoints that answered on 2026-08-29 (findings/06).
# Blast API is RETIRED and returns "use Alchemy instead" — do not use it.
# STARKNET_MAINNET_RPC=https://api.cartridge.gg/x/starknet/mainnet
# STARKNET_SEPOLIA_RPC=https://api.cartridge.gg/x/starknet/sepolia

# Pool addresses (verified live, findings/06)
STRK20_POOL_MAINNET=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
STRK20_POOL_SEPOLIA=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# Hosted proving service and indexer URLs are UNKNOWN — ask StarkWare, do not guess.
# A wrong proving service fails in ways that look like your bug.
# PROVING_SERVICE_URL=
# INDEXER_URL=
